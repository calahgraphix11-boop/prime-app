{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/(sw\\.js|registerSW\\.js)$",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/landing.html"
    },
    {
      "src": "^/privacy\\.html$",
      "dest": "/privacy.html"
    },
    {
      "src": "^/terms\\.html$",
      "dest": "/terms.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    }
  ]
}
